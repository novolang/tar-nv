// pax.nv — POSIX.1-2001's extended header records, which are how tar
// stopped having limits.
//
// WHAT A PAX RECORD IS
//
// A length-prefixed `key=value` line:
//
//     "%d %s=%s\n" % (total_length, key, value)
//
// where `total_length` counts ITSELF.  That self-reference is the
// whole trick and the whole trap: `22 mtime=1757376000.5\n` is
// twenty-two bytes including the two digits of "22", so a writer that
// computes the length without them produces a record every reader
// rejects, and one that gets it wrong by a digit at the 9-to-10
// boundary (where a length of 98 becomes 101) produces a record that works for short values and fails
// for long ones.  `emit_records` computes it correctly, once, and
// that is the main reason this module exists rather than being three
// lines at a call site.
//
// The records live in the data blocks of a `TarPaxHeader` (`x`) entry
// and apply to the entry AFTER it, or of a `TarGlobalPaxHeader` (`g`)
// entry and apply to every entry after that until replaced.  Both are
// consumed by `tarread` and never handed to a caller as entries.
//
// WHY THE VALUE IS A `Str` AND NOT A TYPE PER KEY
//
// Because the key space is open.  POSIX defines eleven keys, GNU adds
// its own, Schily's tar adds more, and a vendor may add
// `VENDOR.keyword` freely — so a parser that typed each key would
// refuse the archives it most needed to read.  Every value is text;
// `pax` hands it back as text; the typed reads a caller actually
// wants — `path`, `size`, `mtime` — are the named accessors below,
// which know their own key's encoding.
//
// THE ENCODING IS UTF-8, AND IT IS NOT VALIDATED
//
// POSIX says a PAX value is UTF-8.  This package does not check, for
// the same reason csv-nv does not check a field: an archive with a
// Latin-1 file name in it is an archive that exists and that somebody
// has to extract.  A caller that needs the guarantee validates what it
// got.

use tarheader
use tarerror

// One `key=value` record from an extended header.
//
// ```novo
// use pax
//
// fn main() [io]
//     println("${pax.record("path", "a/very/long/name").key}")     // path
// ```
pub struct PaxRecord
    // The key, as it appeared: `path`, `linkpath`, `size`, `mtime`,
    // `uid`, `gid`, `uname`, `gname`, `atime`, `ctime`, `comment`, or
    // any vendor key at all.
    key: Str
    // The value, as bytes-that-are-probably-UTF-8, unvalidated.
    value: Str

// A record from a key and a value.
//
// ```novo
// use pax
//
// fn main() [io]
//     println("${pax.record("size", "8589934592").value}")
// ```
pub fn record(key: Str, value: Str) -> PaxRecord
    PaxRecord { key: key, value: value }

// Parse the data blocks of an extended header into records.
//
// `BadPaxRecord` when a length is not a number, when a length does not
// match the record it prefixes, or when a record has no `=`. The
// `block` argument is the archive block the extended header started
// at, and is used only to place those errors.
//
// Records are returned in the order they appeared, INCLUDING repeats:
// POSIX says a later record for a key replaces an earlier one, so the
// order is meaningful and de-duplicating here would throw away the
// rule. `lookup` applies it.
//
// ```novo
// use pax
//
// fn main() [io]
//     match pax.parse_records(bytes.from_str(""), 0)
//         Ok(rs) => println("${list.len(rs)}")             // 0
//         Err(_) => println("malformed")
// ```
pub fn parse_records(data: Bytes, block: Int) -> Result<[PaxRecord], TarError>
    var out: [PaxRecord] = []
    let n = bytes.len(data)
    var at = 0
    while at < n
        var digits = 0
        var len = 0
        while at + digits < n and digits < 19 and is_digit(bytes.byte_at(data, at + digits) ?? 0)
            len = len * 10 + ((bytes.byte_at(data, at + digits) ?? 0) - '0')
            digits = digits + 1
        if digits == 0 or digits == 19
            return Err(BadPaxRecord(block, "a record does not start with a decimal length"))
        if (bytes.byte_at(data, at + digits) ?? 0) != ' '
            return Err(BadPaxRecord(block, "the length is not followed by a space"))
        if len < digits + 4 or at + len > n
            return Err(BadPaxRecord(block, "the length ${len} does not fit the record"))
        if (bytes.byte_at(data, at + len - 1) ?? 0) != '\n'
            return Err(BadPaxRecord(block, "a record does not end in a newline"))
        let body = bytes.slice(data, at + digits + 1, at + len - 1)
        let eq = bytes.find_byte(body, '=', 0) ?? -1
        if eq <= 0
            return Err(BadPaxRecord(block, "a record has no key before its '='"))
        let key = bytes.to_str(bytes.slice(body, 0, eq))
        let value = bytes.to_str(bytes.slice(body, eq + 1, bytes.len(body)))
        if not value_is_well_formed(key, value)
            return Err(BadPaxRecord(block, "the value of ${key} is not a number"))
        list.push(out, PaxRecord { key: key, value: value })
        at = at + len
    Ok(out)

// Records as the bytes of an extended header's payload.
//
// Each record is `"%d %s=%s\n"` with the length counting itself, which
// is the arithmetic this module exists to get right.
//
// ```novo
// use pax
//
// fn main() [io]
//     let b = pax.emit_records([pax.record("path", "x")])
//     println("${bytes.len(b)}")                           // 9
// ```
pub fn emit_records(rs: [PaxRecord]) -> Bytes
    var out = bytes.zeros(records_size(rs))
    var at = 0
    for r in rs
        let n = record_length(r)
        let line = bytes.from_str("${n} ${r.key}=${r.value}\n")
        bytes.copy_into(out, at, line, 0, n)
        at = at + n
    out

// The value for a key, with POSIX's last-one-wins rule applied.
//
// `None` when no record has the key.  A record with an EMPTY value is
// not the same as a missing one: POSIX gives it the meaning "delete
// the value a global header set", so this returns `Some("")` for it
// and a caller matching on `None` will not confuse the two.
//
// ```novo
// use pax
//
// fn main() [io]
//     match pax.lookup([pax.record("path", "x")], "path")
//         Some(v) => println(v)                            // x
//         None    => println("absent")
// ```
pub fn lookup(rs: [PaxRecord], key: Str) -> ?Str
    var found: ?Str = None
    for r in rs
        if r.key == key
            found = Some(r.value)
    found

// The records a header needs in order to be written without loss.
//
// The bridge between `tarheader` and this module, and the reason a
// caller writing PAX does not have to know which fields overflow: give
// it a header and the format's limits, get back the records — a
// `path` record for a path USTAR cannot hold, a `linkpath` for a link
// target, a `size` for a payload over 8 GiB, `uid`/`gid` for ids over
// 2,097,151, `uname`/`gname` for names over 32 bytes.  An empty list
// when the header fits USTAR entirely, which is the common case and
// costs nothing.
//
// ```novo
// use pax
// use tarheader
//
// fn main() [io]
//     println("${list.len(pax.records_for(tarheader.header("a.txt", 10)))}")  // 0
// ```
pub fn records_for(h: TarHeader) -> [PaxRecord]
    var out: [PaxRecord] = []
    if not tarheader.fits_ustar(h.path)
        list.push(out, PaxRecord { key: "path", value: h.path })
    if str.len(h.link) > 100
        list.push(out, PaxRecord { key: "linkpath", value: h.link })
    if h.size >= OCTAL_11 or h.size < 0
        list.push(out, PaxRecord { key: "size", value: "${h.size}" })
    if h.uid >= OCTAL_7 or h.uid < 0
        list.push(out, PaxRecord { key: "uid", value: "${h.uid}" })
    if h.gid >= OCTAL_7 or h.gid < 0
        list.push(out, PaxRecord { key: "gid", value: "${h.gid}" })
    if str.len(h.uname) > 32
        list.push(out, PaxRecord { key: "uname", value: h.uname })
    if str.len(h.gname) > 32
        list.push(out, PaxRecord { key: "gname", value: h.gname })
    if h.mtime >= OCTAL_11 or h.mtime < 0
        list.push(out, PaxRecord { key: "mtime", value: "${h.mtime}" })
    out

// A header with a set of records applied over it.
//
// The other half of the bridge, and what the reader does when it meets
// an `x` entry: the extended header's `path` replaces the block's
// path, its `size` replaces the block's size, and so on for every key
// this package understands. Keys it does not understand are left in
// the entry's record list for a caller to read, never dropped —
// a vendor key is the caller's business and losing it would be this
// package deciding what matters.
//
// ```novo
// use pax
// use tarheader
//
// fn main() [io]
//     let h = pax.apply(tarheader.header("short", 1), [pax.record("path", "much/longer")])
//     println(h.path)                                      // much/longer
// ```
pub fn apply(h: TarHeader, rs: [PaxRecord]) -> TarHeader
    var name = h.path
    var link = h.link
    var size = h.size
    var mtime = h.mtime
    var uid = h.uid
    var gid = h.gid
    var uname = h.uname
    var gname = h.gname
    match effective(rs, "path")
        Some(v) =>
            name = v
        None    => 0
    match effective(rs, "linkpath")
        Some(v) =>
            link = v
        None    => 0
    match effective(rs, "uname")
        Some(v) =>
            uname = v
        None    => 0
    match effective(rs, "gname")
        Some(v) =>
            gname = v
        None    => 0
    match number_of(rs, "size")
        Some(v) =>
            size = v
        None    => 0
    match number_of(rs, "uid")
        Some(v) =>
            uid = v
        None    => 0
    match number_of(rs, "gid")
        Some(v) =>
            gid = v
        None    => 0
    match effective(rs, "mtime")
        Some(v) =>
            match seconds_of(v)
                Some(t) =>
                    mtime = t
                None    => 0
        None    => 0
    TarHeader { path: name, mode: h.mode, uid: uid, gid: gid, size: size, mtime: mtime,
                kind: h.kind, link: link, uname: uname, gname: gname,
                devmajor: h.devmajor, devminor: h.devminor }

// The size in bytes an extended header's payload will occupy.
//
// `bytes.len(emit_records(rs))` without building the bytes, for the
// writer computing a header block before it has the payload.  It is
// exposed because the self-counting length makes this genuinely hard
// to predict and a caller building an index needs the number.
//
// ```novo
// use pax
//
// fn main() [io]
//     println("${pax.records_size([pax.record("path", "x")])}")   // 9
// ```
pub fn records_size(rs: [PaxRecord]) -> Int
    var total = 0
    for r in rs
        total = total + record_length(r)
    total

// The largest values the octal fields of a header block hold, plus one:
// seven digits for uid and gid, eleven for size and mtime.
const OCTAL_7 = 2097152
const OCTAL_11 = 8589934592

// The keys `apply` copies into a header, which `unapplied` therefore
// leaves out.
fn is_applied(key: Str) -> Bool
    key == "path" or key == "linkpath" or key == "size" or key == "uid"
        or key == "gid" or key == "uname" or key == "gname"

// The records `apply` does not copy into a header: vendor keys, the
// times a header does not hold, and an `mtime` whose fraction a header
// cannot keep.  In their original order.
//
// ```novo
// use pax
//
// fn main() [io]
//     let rs = [pax.record("path", "x"), pax.record("comment", "hi")]
//     println("${list.len(pax.unapplied(rs))}")            // 1
// ```
pub fn unapplied(rs: [PaxRecord]) -> [PaxRecord]
    var out: [PaxRecord] = []
    for r in rs
        if is_applied(r.key)
            continue
        if r.key == "mtime" and not str.contains(r.value, ".")
            continue
        list.push(out, r)
    out

fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

// The bytes one record occupies: its length counts its own digits, so
// the digit count is found by trying one more digit until it settles.
fn record_length(r: PaxRecord) -> Int
    let rest = str.len(r.key) + str.len(r.value) + 3
    var digits = 1
    while digits_in(rest + digits) > digits
        digits = digits + 1
    rest + digits

fn digits_in(n: Int) -> Int
    var d = 1
    var v = n
    while v >= 10
        v = v / 10
        d = d + 1
    d

// The last value for a key, ignoring an empty one: an empty value
// withdraws what a global header set, which leaves the header's own.
fn effective(rs: [PaxRecord], key: Str) -> ?Str
    match lookup(rs, key)
        Some(v) =>
            if str.len(v) == 0
                return None
            Some(v)
        None    => None

fn number_of(rs: [PaxRecord], key: Str) -> ?Int
    match effective(rs, key)
        Some(v) => decimal(v)
        None    => None

// A non-negative decimal number of at most 18 digits.
fn decimal(text: Str) -> ?Int
    let n = str.len(text)
    if n == 0 or n > 18
        return None
    var value = 0
    for i in 0..n
        let b = str.byte_at(text, i) ?? 0
        if not is_digit(b)
            return None
        value = value * 10 + (b - '0')
    Some(value)

// Whole seconds of a decimal time with an optional sign and fraction,
// rounded toward minus infinity.
fn seconds_of(text: Str) -> ?Int
    var body = text
    var negative = false
    if str.starts_with(body, "-")
        negative = true
        body = str.slice(body, 1, str.len(body))
    var whole = body
    var fraction = ""
    match str.index(body, ".")
        Some(dot) =>
            whole = str.slice(body, 0, dot)
            fraction = str.slice(body, dot + 1, str.len(body))
        None      => 0
    var seconds = 0
    match decimal(whole)
        Some(v) =>
            seconds = v
        None    =>
            return None
    if not negative
        return Some(seconds)
    if str.len(fraction) > 0 and fraction != str.repeat("0", str.len(fraction))
        return Some(-seconds - 1)
    Some(-seconds)

// Whether a record's value suits its key: the numeric keys must hold
// numbers, or nothing.
fn value_is_well_formed(key: Str, value: Str) -> Bool
    if str.len(value) == 0
        return true
    if key == "size" or key == "uid" or key == "gid"
        return decimal(value) != None
    if key == "mtime" or key == "atime" or key == "ctime"
        return time_is_well_formed(value)
    true

fn time_is_well_formed(text: Str) -> Bool
    var body = text
    if str.starts_with(body, "-")
        body = str.slice(body, 1, str.len(body))
    match str.index(body, ".")
        Some(dot) =>
            let frac = str.slice(body, dot + 1, str.len(body))
            let whole = str.slice(body, 0, dot)
            if str.len(frac) == 0 or str.len(whole) == 0
                return false
            for i in 0..str.len(frac)
                if not is_digit(str.byte_at(frac, i) ?? 0)
                    return false
            decimal(whole) != None
        None      => decimal(body) != None
